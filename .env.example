# ─────────────────────────────────────────────────────────────
# Solither configuration. Copy this file to ".env" and edit.
# ─────────────────────────────────────────────────────────────

# HTTP/WebSocket port the server listens on.
PORT=3000

# ── Solana token gating ──────────────────────────────────────
# The SPL token mint address players must hold to play.
# Leave EMPTY to run in DEMO mode (no real balance check — anyone can join).
TOKEN_MINT=

# Minimum token balance (in whole tokens, not raw units) required to play.
MIN_TOKEN_BALANCE=500000

# Solana RPC endpoint used to read balances.
# Public endpoint works for low traffic; use Helius/QuickNode for production.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# How long (seconds) a passed wallet check stays cached before re-verification.
BALANCE_CACHE_SECONDS=120

# Max concurrent human players before new joins see "arena is full".
MAX_PLAYERS=50

# ── Reward rounds ────────────────────────────────────────────
# Length of a reward round in seconds (default 180 = 3 minutes).
ROUND_SECONDS=180

# Number of top players rewarded each round.
REWARD_TOP_N=5

# Reward pool per round (placeholder for the creator fees collected that period).
# Top 5 split 30/20/15/10/10% (= 85% to players); creator keeps 15%.
ROUND_REWARD_SOL=0.25

# ── On-chain payout (sends REAL SOL — keep OFF until you mean it) ─────────────
# PAYOUT_ENABLED=1 turns on automatic transfers to the top-5 wallets each round.
# TREASURY_SECRET_KEY is your funded hot-wallet's 64-byte secret key as a JSON array
# (e.g. the contents of a solana-keygen .json). NEVER commit this; set it in Railway vars only.
PAYOUT_ENABLED=
TREASURY_SECRET_KEY=
